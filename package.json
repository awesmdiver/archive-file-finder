    "type": "git",
    "url": "https://github.com/awesmdiver/archive-file-finder.git"
  },
  "homepage": "https://github.com/awesmdiver/archive-file-finder#readme",
  "bugs": {
    "url": "https://github.com/awesmdiver/archive-file-finder/issues"
  },
  "keywords": [
    "skyrim",
    "vortex",
    "mod-organizer",
    "mod-manager",
    "7-zip",
    "archive-search"
  ]
}
